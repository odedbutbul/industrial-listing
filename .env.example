# שמות בלבד — ערכים אמיתיים ב-.env.local (מקומי) או בהגדרות השרת. לעולם לא לעשות commit לערכים.

# אפליקציה
APP_BASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# DB (מקומי: npm run db:up → postgres://sync:sync_dev_only@localhost:5442/stock_sync)
DATABASE_URL=

# eBay
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=
EBAY_SANDBOX=true
TOKEN_ENCRYPTION_KEY=
# חשבון eBay חי — כתיבה ל-eBay חסומה אלא אם true. רק עודד מפעיל.
EBAY_WRITES_ENABLED=false

# WooCommerce
WC_BASE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=

# סנכרון
CRON_SECRET=
SYNC_PUSH_ENABLED=false

# זמני — עד הסרת Supabase (שלב 6)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
